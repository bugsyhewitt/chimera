# CHIMERA — environment template
#
# Copy this file to `.env` (which is gitignored) and fill in real values:
#     cp .env.example .env
#
# REAL CREDENTIALS ARE NEVER COMMITTED. Only this placeholder template is tracked.
# The orchestrator (orchestrator/chimera/config.py via pydantic-settings) and the
# scripts (install_uf.sh, smoke_test.sh, seed_p15_demo.py) all read from `.env`.

# ---- Splunk core ----
SPLUNK_HOST=localhost
SPLUNK_WEB_PORT=8000
SPLUNK_MGMT_PORT=8089
SPLUNK_ADMIN_USER=admin
SPLUNK_ADMIN_PASSWORD=CHANGE_ME

# ---- Splunk MCP Server (the orchestrator's data plane) ----
# Endpoint is the streamable-HTTP MCP URL; token is the MCP bearer token.
SPLUNK_MCP_ENDPOINT=https://localhost:8089/services/mcp
SPLUNK_MCP_TOKEN=CHANGE_ME

# ---- Ollama / Foundation-Sec-8B (hosted model) ----
OLLAMA_BASE_URL=http://localhost:11434
FOUNDATION_SEC_MODEL=FenkoHQ/Foundation-Sec-8B

# ---- Router / deception gateway ----
# simulate = record the would-route decision (default; safe on a workstation).
# enforce  = maintain nftables sets + DNAT hostile sources to honeypots (real deploys).
CHIMERA_ROUTER_MODE=simulate

# ---- Session lifecycle ----
# Seconds of silence before a honeypot session is finalized. Lower for demos/tests.
CHIMERA_SESSION_IDLE_SECONDS=300
